FEED_MODE=kotak
PUSH_INTERVAL=1

# Kotak Neo Trade API
NEO_CONSUMER_KEY=YOUR_CONSUMER_KEY
NEO_MOBILE_NUMBER=YOUR_MOBILE_NUMBER
NEO_UCC=YOURUCC
NEO_TOTP_SECRET=BASE32SECRETFROMTOTPREGISTRATION
NEO_MPIN=YOUR_MPIN

# print raw SFeedScrip fields once (use on first live run)
NEO_DEBUG_FIELDS=0

# ---- Order desk ----------------------------------------------------------
# paper = simulated fills (default). live = REAL orders via Kotak.
TRADING_MODE=paper
# Required for live mode; the browser asks for it once per tab.
ORDER_API_TOKEN=change-me-long-random-string

# Stocks (cash)
MAX_QTY_CASH=10
MAX_ORDER_VALUE_CASH=20000
# Futures: off by default. One lot is the minimum (often ₹5-15 lakh notional).
ALLOW_FO=0
MAX_LOTS_FO=1
MAX_ORDER_VALUE_FO=1500000

MAX_ORDERS_PER_DAY=20
# Intraday (MIS) cut-off: new MIS orders blocked after this; paper MIS positions auto-exit.
# Set to YOUR broker's auto square-off time (check Kotak Neo's current timing).
SQUAREOFF_TIME=15:15
# Broker's auto square-off fee (+GST), charged if the broker closes your MIS position
AUTO_SQUAREOFF_FEE=49
# Limit price must be within ±x% of LTP (fat-finger guard)
PRICE_BAND_PCT=1.0
MIN_SECONDS_BETWEEN_ORDERS=2

# ---- Charges for net P&L (match YOUR Kotak Neo plan; check one contract note) ----
# Trade Free: delivery 0.20% (free first 30 days) | Trade Free Max: 0.10% | Youth: 0
BROKERAGE_DELIVERY_PCT=0.20
BROKERAGE_INTRADAY_FLAT=10
BROKERAGE_INTRADAY_PCT=0.05
BROKERAGE_FO_FLAT=10
# DP charge per scrip per day on delivery sells (before GST)
DP_CHARGE_PER_SELL=20

# ---- Signals (rule-based setups, not advice) -------------------------------
# ₹ you're willing to lose per trade if the stop is hit -> sets the suggested quantity
RISK_PER_TRADE=50
# Target = entry + TARGET_R x risk
TARGET_R=2
# Opening range length (minutes after 09:15) used by the breakout setup
ORB_MINUTES=15
# Breakouts need volume at least this many times a normal day's pace
MIN_RVOL=1.2
NO_NEW_ENTRIES_AFTER=14:45
# Exit alert for intraday positions after this time
TIME_EXIT=15:05

# ---- Swing trading (hold days to ~3 weeks, Delivery) -------------------------
# ₹ you're willing to lose per swing trade if the stop is hit -> sets quantity
SWING_RISK_PER_TRADE=1200
SWING_MAX_ORDER_VALUE=50000
SWING_MAX_QTY=500
SWING_MAX_POSITIONS=5
SWING_TARGET_R=2
# Stop distance for breakouts, in multiples of the 14-day ATR
SWING_ATR_STOP=2
# Exit if the target isn't reached within this many trading days
SWING_TIME_STOP_DAYS=15
# Net month-to-date loss (realised + open) at which ALL new buys are blocked
MONTHLY_LOSS_LIMIT=8000

# Demo mode replays a whole trading day at this speed (20 = ~19 minutes). 0 = real clock.
MOCK_TIME_SCALE=20
